{
  "name": "bcai-workbench",
  "version": "1.0.0",
  "framework": "vite",
  "buildCommand": "npm run build:pages",
  "outputDirectory": "dist-pages",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/auth/callback",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
