# ==========================================
# BCAI 工作台环境变量配置示例
# ==========================================

# 1. Google Gemini API (服务器端 @google/genai 调用)
# AI Studio 环境下会自动注入；在 Pages / Vercel / VPS / Docker 中请自行设置
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. 应用访问 URL（OAuth 回调需要，AI Studio 自动注入）
APP_URL="MY_APP_URL"

# 3. 管理员后台登录密码（默认无登录界面阻挡；设置后管理员可用此密码登录管理外接 API/数据库/仓库/连接器）
ACCESS_PASSWORD=""

# 4. 默认目标开源仓库地址（可自定义覆盖）
TARGET_REPO_URL="https://github.com/757926525/bcai"

# 5. Cloudflare Workers AI & D1 数据库绑定（可选）
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_D1_DATABASE_ID=""

# 6. 对象存储桶绑定（Cloudflare R2 / 任意 S3 兼容存储桶，可选）
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# 7. 外接大模型后端环境变量（可选：设置后自动出现在“免费扩展/外接模型”选区）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODELS="gpt-4o-mini"

OPENROUTER_API_KEY=""

# 8. Git 仓库授权连接（可选：支持 GitHub OAuth / Token、GitLab、Gitee）
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_TOKEN=""
GITLAB_TOKEN=""
GITEE_TOKEN=""
