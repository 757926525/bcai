# ==========================================
# AIMX AI 工作台环境变量配置示例
# ==========================================

# 1. Google Gemini API (服务器端 @google/genai 调用)
# AI Studio 环境下会自动注入；在 Pages / Vercel / VPS / Docker 中请自行设置
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. 应用访问 URL（OAuth 回调需要，AI Studio 自动注入）
APP_URL="MY_APP_URL"

# 3. 站点访问密码（可选：设置后进入计划登录面板需要输入密码解锁）
ACCESS_PASSWORD=""

# 4. Cloudflare Workers AI & D1 数据库绑定（可选）
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_D1_DATABASE_ID=""

# 5. 外接大模型后端环境变量（可选：设置后自动出现在“免费扩展/外接模型”选区）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODELS="gpt-4o-mini"

OPENROUTER_API_KEY=""

# 6. GitHub OAuth 授权应用配置（可选：用于跳转 GitHub 一键授权登录）
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
